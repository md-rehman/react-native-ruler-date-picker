{
  "name": "react-native-ruler-date-picker",
  "version": "0.2.0",
  "description": "A performant, customizable horizontal ruler date picker & scroll wheel for React Native & Expo — 60 FPS Reanimated 3 physics, dual-speed haptic feedback, fluid date range selection, and windowed tick rendering.",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "sideEffects": false,
  "engines": {
    "node": ">=18.0.0"
  },
  "exports": {
    ".": {
      "types": "./lib/typescript/index.d.ts",
      "react-native": "./src/index.ts",
      "import": "./lib/module/index.js",
      "require": "./lib/commonjs/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "README.md",
    "LICENSE",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__"
  ],
  "scripts": {
    "build": "bob build",
    "prepack": "bob build",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "clean": "rm -rf lib"
  },
  "keywords": [
    "react-native",
    "react-native-date-picker",
    "react-native-date-range-picker",
    "react-native-calendar-strip",
    "react-native-calendar",
    "react-native-timeline",
    "react-native-wheel-picker",
    "react-native-scroll-picker",
    "react-native-component",
    "date-picker",
    "date-range-picker",
    "range-picker",
    "horizontal-date-picker",
    "horizontal-calendar",
    "horizontal-picker",
    "ruler-date-picker",
    "ruler-picker",
    "ruler",
    "scroll-picker",
    "wheel-picker",
    "timeline-picker",
    "timeline",
    "calendar-strip",
    "calendar",
    "datepicker",
    "expo",
    "expo-date-picker",
    "reanimated",
    "reanimated-3",
    "gesture-handler",
    "haptics",
    "haptic-feedback",
    "smooth-scroll",
    "ui-components",
    "ios",
    "android"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/md-rehman/react-native-ruler-date-picker.git",
    "directory": "packages/react-native-ruler-date-picker"
  },
  "author": "Rehman <md.rehman.dev@gmail.com> (https://md-rehman.dev)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/md-rehman/react-native-ruler-date-picker/issues"
  },
  "homepage": "https://md-rehman.dev/react-native-ruler-date-picker",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.72.0",
    "react-native-gesture-handler": ">=2.0.0",
    "react-native-reanimated": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "expo-haptics": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/react": "^19.0.0",
    "@types/react-native": "^0.72.0",
    "eslint": "^8.57.0",
    "expo-haptics": "^14.0.0",
    "jest": "^30.5.1",
    "react": "^19.0.0",
    "react-native": "^0.76.0",
    "react-native-builder-bob": "^0.35.0",
    "react-native-gesture-handler": "^2.20.0",
    "react-native-reanimated": "^3.16.0",
    "ts-jest": "^29.4.12",
    "typescript": "^5.4.0"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "commonjs",
        {
          "esm": true
        }
      ],
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  }
}
